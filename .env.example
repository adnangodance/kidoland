# Kidoland Production Environment Configuration
# Copy this file to .env and customize for your deployment

# Runtime Environment (production, development, test)
NODE_ENV=production

# Server Port & Host Binding
PORT=4000
HOST=0.0.0.0

# Mandatory in Production: Strong JWT Secret key (at least 32 characters)
# Generate one using: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_at_least_32_char_secret_key

# SQLite Database Location
# In Docker, persist this directory using a volume mount
KIDOLAND_DB_PATH=/data/kidoland.sqlite

# CORS Configuration
# Set comma-separated allowed origins (e.g. https://kidoland.app,https://admin.kidoland.app)
# Leave empty to allow same-origin or reflect origin in development
CORS_ORIGIN=

# Demo Data Seeding (false in production)
# Set to 'true' if you want demo accounts and fixture children created automatically
SEED_DEMO_DATA=false

# Frontend UI: Show quick demo login chips on the login screen
# Set to 'false' in production so users see only clean email/password inputs
VITE_SHOW_DEMO=false

# Optional: Custom backend API URL for standalone frontend deployments (e.g. Vercel)
# If frontend is served by Express (same origin), leave empty
VITE_API_URL=
